{
  "name": "pi-ui-kit",
  "version": "0.1.4",
  "description": "UI components for Pi extensions, built on Pi's TUI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": "./src/core.ts",
    "./list": "./src/list.ts",
    "./tabs": "./src/tabs.ts",
    "./preview": "./src/preview.ts",
    "./key-hints": "./src/key-hints.ts",
    "./frame": "./src/frame.ts",
    "./picker": "./src/picker.ts",
    "./shortcut": "./src/shortcut.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "pi-core-kit": "git+https://github.com/Rubio-Enterprises/pi-core-kit.git#v2.1.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.project.json && tsc -p tsconfig.strict.json && tsc -p tsconfig.tests.json",
    "lint": "mise exec -- biome check .",
    "test": "bun run scripts/run-tests.ts",
    "typecheck": "tsc -p tsconfig.project.json && tsc -p tsconfig.strict.json && tsc -p tsconfig.tests.json"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/bun": "1.4.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
